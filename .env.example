# Required service credentials. Use long, unique values; never commit a real .env file.
DTAT_USERNAME=admin
DTAT_PASSWORD=
POSTGRES_PASSWORD=

# Optional Azure-compatible API key. If omitted, DTAT_PASSWORD is used.
DTAT_AZURE_COMPAT_KEY=

# OCR engines are opt-in so a fresh install does not make unexpected paid API calls.
ENABLE_TEXTRACT=false
ENABLE_LOCAL_OCR=false
OCR_OFFLINE_MODE=true

# Provider configuration (only required for enabled engines).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_DI_ENABLED=false
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Processing and persistence.
MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_FRAMES=50
MAX_ARCHIVE_UNCOMPRESSED_MB=250
MAX_CSV_ROWS=100000
STORE_ORIGINAL_FILE=true
